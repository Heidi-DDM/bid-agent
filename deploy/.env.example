# 服务器环境变量模板（docs/11-部署方案-阿里云演示环境.md §5）
# 复制到服务器 ~/bid-agent/deploy/.env 后填写真实值并 chmod 600；真实值禁止进入 Git。

# ---- 应用 ----
APP_ENV=prod
LOG_LEVEL=INFO
BIND_HOST=0.0.0.0
BIND_PORT=8000
OBJECT_STORE_ROOT=/data/objects
OCR_LANG=chi_sim

# ---- 数据库（db 容器；口令随机生成，例：openssl rand -hex 24）----
POSTGRES_PASSWORD=<随机口令>
DATABASE_URL=postgresql+psycopg://bid_agent:<随机口令>@db:5432/bid_agent

# ---- 模型/RAG：演示环境不部署 embedding 服务（用户决策 2026-09-11）----
PGVECTOR_ENABLED=false
MODEL_BASE_URL=
MODEL_NAME=
EMBEDDING_MODEL=
RERANKER_ENABLED=false
DEEPSEEK_ENABLED=false
DEEPSEEK_PUBLIC_ONLY=true

# ---- 认证（F020 §5.1）----
# AUTH_USERS 格式：login:pbkdf2_sha256$iter$salt$hash:role:display_name;...
# 哈希生成（本机仓库根目录）：
#   .venv/bin/python -c "from runtime.core.auth import hash_password;print(hash_password('口令'))"
# 角色：bid_specialist / data_admin / business_head / legal
AUTH_USERS=<login:hash:role:name;...>
AUTH_TOKEN_SECRET=<随机 48 字节，例：openssl rand -hex 48>
AUTH_DEV_HEADERS=false

# ---- nginx 对外端口（阿里云安全组已放行 2000）----
PUBLIC_PORT=2000
