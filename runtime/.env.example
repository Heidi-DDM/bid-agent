# 模型密钥与运行配置模板
# 复制为 .env 后填写；.env 已被 .gitignore 排除，禁止提交真实值。
# 字段清单见 F018 §3。
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL 连接串（本地开发默认账号由 setup_local_env.sh 自动创建；
# 生产使用独立账号 + 最小权限，F018 §6）
DATABASE_URL=postgresql+psycopg://bid_agent:bid_agent_dev@127.0.0.1:5432/bid_agent

# 对象存储根目录（文件不直接存数据库，F018 §2）
OBJECT_STORE_ROOT=/absolute/path/to/bid_agent_objects

# 模型适配器（仅内网/本地地址；留空则 /readyz 中模型标记为未启用）
MODEL_BASE_URL=http://127.0.0.1:8001
MODEL_NAME=company-approved-local-model

# OCR（F017 复用）
OCR_LANG=chi_sim

# 服务绑定（开发环境默认 127.0.0.1，F018 §6）
BIND_HOST=127.0.0.1
BIND_PORT=8000

# 任务参数
WORKER_POLL_INTERVAL_SECONDS=5
JOB_RUNNING_TIMEOUT_SECONDS=600