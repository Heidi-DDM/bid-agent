# 模型密钥与运行配置模板
# 复制为 .env 后填写；.env 已被 .gitignore 排除，禁止提交真实值。
# API/worker 启动时自动加载 runtime/.env（已有环境变量优先，不覆盖）。
# 字段清单见 F018 §3。
APP_ENV=dev
LOG_LEVEL=INFO

# PostgreSQL 连接串（本地开发默认账号由 setup_local_env.sh 自动创建；
# 生产使用独立账号 + 最小权限，F018 §6）
DATABASE_URL=postgresql+psycopg://bid_agent:bid_agent_dev@127.0.0.1:5432/bid_agent

# 对象存储根目录（文件不直接存数据库，F018 §2）
OBJECT_STORE_ROOT=/absolute/path/to/bid_agent_objects

# 模型适配器（仅内网/本地地址；留空则 /readyz 中模型标记为未启用）
MODEL_BASE_URL=http://127.0.0.1:8001
MODEL_NAME=company-approved-local-model
# /readyz 使用短探测；实际 embedding/rerank 推理允许模型冷启动完成。
MODEL_REQUEST_TIMEOUT_SECONDS=60

# RAG/知识库（F025）：企业 embedding 仅使用本地/内网模型；
# 向量索引不可用时任务必须失败，不得伪造成功。
PGVECTOR_ENABLED=false
EMBEDDING_MODEL=bge-m3-local
EMBEDDING_DIM=1024
RERANKER_ENABLED=true
# 本地 cross-encoder；需显式执行 bash embedding_serve/start.sh download-models 下载。
RERANKER_MODEL=bge-reranker-v2-m3-local
RAG_TOP_K=20
# 先从关键词/向量/RRF 取得候选池，重排后再截取请求 top_k；最小值受 top_k 约束。
RAG_RERANK_CANDIDATE_K=60
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80

# DeepSeek 仅允许处理 public_read 数据；测试期默认关闭外部模型。
DEEPSEEK_ENABLED=false
DEEPSEEK_PUBLIC_ONLY=true
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

# P4 规则预筛 + 云端大模型受约束兜底（docs/10 §5 P4）：默认关；生效还需上面的 DeepSeek 门禁通过。
# 模型只定位原文逐字摘录，值由确定性解析器派生，产物 confidence=low 必须人工确认。
LLM_FALLBACK_ENABLED=false
LLM_FALLBACK_MAX_CHARS=12000
LLM_FALLBACK_TIMEOUT_SECONDS=60

# OCR（F017 复用）
OCR_LANG=chi_sim

# 服务绑定（开发环境默认 127.0.0.1，F018 §6）
BIND_HOST=127.0.0.1
BIND_PORT=8000

# 任务参数
WORKER_POLL_INTERVAL_SECONDS=5
JOB_RUNNING_TIMEOUT_SECONDS=600
# worker 进程心跳超时（ADR-004 §2.6 / P0-01）：/readyz.worker 在最近心跳超过此秒数时报告不可用（整体 503）
WORKER_HEARTBEAT_STALE_SECONDS=60

# 正式认证（R024 / F020 §5.1）
# AUTH_USERS：login:pbkdf2_sha256$迭代$salt$hash:role:显示名，多账号用 ';' 分隔
#   （显示名不含 ':' 与 ';'）。生成哈希：.venv/bin/python -c
#   "from runtime.core.auth import hash_password; print(hash_password('密码'))"
# AUTH_TOKEN_SECRET：token 签名密钥（生产必须随机长串，如 openssl rand -hex 32）
# AUTH_DEV_HEADERS：仅开发/测试允许 X-Role/X-Actor 回退；正式环境必须 false/移除（fail-closed）
AUTH_USERS=
AUTH_TOKEN_SECRET=
AUTH_DEV_HEADERS=false
